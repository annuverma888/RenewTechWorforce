# Server Port (Render automatically sets PORT in production)
PORT=5000

# MongoDB Connection String (MongoDB Atlas URI in production)
MONGO_URI=

# JWT Secret Key (Use a strong random secret in production)
JWT_SECRET=

# Environment Mode (development | production)
NODE_ENV=production

# Frontend Client URL for CORS (e.g. https://your-project.vercel.app or http://localhost:5173)
CLIENT_URL=
FRONTEND_URL=

